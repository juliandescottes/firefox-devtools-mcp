{
  "name": "firefox-devtools-mcp",
  "displayName": "Firefox MCP (old plugin name)",
  "description": "Renamed to firefox-mcp. This old entry only keeps the Firefox MCP server running for existing installs, with its old tool names. Install firefox-mcp to get the skills, agents and commands, then uninstall this one.",
  "author": {
    "name": "Mozilla",
    "url": "https://github.com/mozilla/firefox-mcp"
  },
  "repository": "https://github.com/mozilla/firefox-mcp",
  "homepage": "https://github.com/mozilla/firefox-mcp",
  "license": "MIT OR Apache-2.0",
  "mcpServers": {
    "firefox-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "@mozilla/firefox-mcp@latest",
        "--auto-profile",
        "--tool-preset",
        "developer",
        "--pref",
        "remote.prefs.recommended=false"
      ]
    }
  }
}
